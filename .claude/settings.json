{
  "permissions": {
    "allow": [
      "Bash(mkdir:*)",
      "Bash(rm:*)",
      "Bash(ls:*)",
      "Bash(cat:*)",
      "Bash(cp:*)",
      "Bash(mv:*)",

      "Bash(git add:*)",
      "Bash(git commit:*)",
      "Bash(git push:*)",
      "Bash(git log:*)",
      "Bash(git config:*)",
      "Bash(git reset:*)",

      "Bash(mvn:*)",
      "Bash(gradle:*)",
      "Bash(./gradlew:*)",

      "Bash(java:*)",
      "Bash(javac:*)",
      "Bash(jar:*)",

      "Bash(go vet:*)",
      "Bash(go build:*)",
      "Bash(go test:*)",

      "Bash(pytest:*)",
      "Bash(python -m pytest:*)",
      "Bash(python -m py_compile:*)",
      "Bash(python -m compileall:*)",

      "Bash(npm run build:*)",
      "Bash(npm run test:*)",
      "Bash(npm test:*)",
      "Bash(npx vitest:*)",

      "Bash(mvn test:*)",
      "Bash(gradle test:*)",

      "Bash(mvn dependency:*)",
      "Bash(gradle dependencies:*)"
    ],

    "deny": [
      "Bash(rm -rf:*)",
      "Read(./.env)",
      "Read(./secrets/**)"
    ],

    "additionalDirectories": [
    ],

    "defaultMode": "acceptEdits",
    "disableBypassPermissionsMode": "disable"
  },

  "env": {
    "MAVEN_OPTS": "-Xmx1024m"
  },

  "outputStyle": "Explanatory"
}
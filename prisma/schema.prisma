// Ember - Emby 用户管理系统数据库 Schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ===========================
// 数据库设计决策说明
// ===========================
//
// 1. 主键类型：String (cuid) vs Int (autoincrement)
//    - 所有表使用 String @default(cuid()) 作为主键
//    - 理由：
//      a) 安全性：防止ID枚举攻击，不暴露业务数据（用户数、增长速度）
//      b) 分布式友好：未来扩展到多数据库副本时无需改造
//      c) 跨表引用：Log.targetId 可以灵活指向任意表的ID
//      d) 实际性能差异微不足道：在1万用户规模，String vs Int 查询差异 <0.1ms
//
// 2. User.inviteCode：引用业务字段 (Invite.code) 而非主键 (Invite.id)
//    - 设计理由：
//      a) 数据语义：注册是"历史事件"而非"持续关系"
//         - inviteCode 保存的是"我用哪个码注册的"（历史快照）
//         - 而非"我属于哪个邀请码"（当前关系）
//      b) 历史数据完整性：
//         - 即使邀请码被删除，用户记录仍保留完整的注册历史
//         - 类似电商订单保存商品名称，而不是仅保存商品ID
//      c) 审计友好：日志和报表中直接显示邀请码，无需join查询
//    - 权衡：
//      - ✅ 保留历史数据，邀请码删除不影响用户记录
//      - ✅ 当前已禁止删除已使用的邀请码，避免孤儿数据
//      - ❌ 违反"外键引用主键"的教条，但符合业务语义
//
// 参考：docs/development-guide.md "数据库设计决策" 章节
// ===========================

// 管理员表
model Admin {
  id        String   @id @default(cuid())
  username  String   @unique
  password  String   // bcrypt hash, cost=10
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@map("admins")
}

// 邀请码表
model Invite {
  id          String    @id @default(cuid())
  code        String    @unique // 8位随机字符串
  maxUses     Int       @default(1) // 最大使用次数
  usedCount   Int       @default(0) // 已使用次数
  expiresAt   DateTime? // 可选的过期时间
  defaultDays Int       @default(30) // 默认账号有效天数
  createdAt   DateTime  @default(now())

  // 关系：一个邀请码可以创建多个用户
  users User[]

  @@map("invites")
  @@index([code])
}

// 用户表
model User {
  id         String    @id @default(cuid())
  username   String    @unique
  email      String
  embyId     String    @unique // Emby用户ID（Emby返回）
  inviteCode String    // 使用的邀请码（历史快照，见顶部设计决策说明）
  expiresAt  DateTime? // 账号到期时间（null=永久有效）
  isActive   Boolean   @default(true) // 账号状态
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  // 关系：注册时使用的邀请码（可选关系，邀请码可能被删除）
  invite Invite @relation(fields: [inviteCode], references: [code])

  @@map("users")
  @@index([username])
  @@index([embyId])
  @@index([expiresAt]) // 定时任务查询到期用户
}

// 操作日志表（简化版，可选）
model Log {
  id        String   @id @default(cuid())
  action    String // "admin_login", "create_user", "delete_user", etc.
  targetId  String? // 目标对象ID（如用户ID）
  details   Json? // 额外信息（JSON格式）
  createdAt DateTime @default(now())

  @@map("logs")
  @@index([action])
  @@index([createdAt])
}

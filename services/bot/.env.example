# ==================== Telegram Bot 配置（本地开发示例） ====================
# 用法：
#   cp .env.example .env.local
# 说明：
#   系统环境变量优先，其次读取 .env.local，再读取 .env

# Bot Token（来自 @BotFather）
TELEGRAM_BOT_TOKEN="your-bot-token"

# 管理员 Telegram 用户 ID（来自 @userinfobot）
TELEGRAM_ADMIN_CHAT_ID="123456789"

# 可选：群组 Chat ID（用于播放排行榜等群消息推送；未配置时会回退推送到管理员）
# TELEGRAM_GROUP_CHAT_ID="-1001234567890"

# Telegram webhook 校验密钥（必须与 set_webhook 的 secret_token 一致）
# 生成方法：openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# Bot 与 API 内部通信密钥（需与 API 的 INTERNAL_API_SECRET 一致）
INTERNAL_API_SECRET="your-internal-api-secret"

# Bot 公网 HTTPS 地址（例如 cloudflared 的 trycloudflare 域名）
WEBHOOK_URL="https://your-subdomain.trycloudflare.com"

# 可选：Go API 地址（默认 http://localhost:8080）
API_URL="http://localhost:8080"

# 可选：Bot 监听端口（默认 8000）
BOT_PORT="8000"

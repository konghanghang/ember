# ==================== Telegram Bot 配置（仅保留必须放在环境变量里的项） ====================
# 用法：
#   cp .env.example .env.local
# 说明：
#   系统环境变量优先，其次读取 .env.local，再读取 .env
#   这里只保留 Bot 启动依赖和跨进程共用的运维参数
#   管理员/群组 Chat ID 已改为优先走 API 运行期设置，不再放在示例里

# 项目级应用日志：info（默认）或 debug
LOG_LEVEL="info"

# Bot Token（来自 @BotFather）
TELEGRAM_BOT_TOKEN="your-bot-token"

# Telegram 更新模式：webhook 或 polling（默认 webhook）
# 不写时默认为 webhook；这里保留是为了显式表达当前接入方式
TELEGRAM_UPDATE_MODE="webhook"

# 仅 webhook 模式需要：Telegram webhook 校验密钥（必须与 set_webhook 的 secret_token 一致）
# 生成方法：openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# Bot 与 API 内部通信密钥（需与 API 的 INTERNAL_API_SECRET 一致）
INTERNAL_API_SECRET="your-internal-api-secret"

# 仅 webhook 模式需要：Bot 公网 HTTPS 地址（例如 cloudflared 的 trycloudflare 域名）
WEBHOOK_URL="https://your-subdomain.trycloudflare.com"

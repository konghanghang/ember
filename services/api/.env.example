# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接字符串
# 注意：Go 服务使用 search_path（PostgreSQL 标准参数）
# Prisma 使用 schema 参数，两者功能相同但语法不同
DATABASE_URL="postgresql://postgres:password@localhost:5432/ember?search_path=public"

# PostgreSQL 密码（Docker Compose 使用）
POSTGRES_PASSWORD="password"

# ==================== 认证配置 ====================
# JWT 密钥（至少 32 个字符，生产环境必须修改）
# 生成方法：openssl rand -base64 32
JWT_SECRET="your-secret-key-min-32-chars-change-this-in-production"

# 管理员初始密码（可选，默认为 admin123）
# ⚠️ 警告：生产环境强烈建议设置此值！
# 首次部署后，请立即在系统设置中修改密码
ADMIN_DEFAULT_PASSWORD="admin123"

# ==================== Emby 服务器配置 ====================
# Emby 服务器地址（不要以 / 结尾）
EMBY_URL="https://your-emby-server.com"

# Emby API 密钥（在 Emby 后台生成）
EMBY_API_KEY="your-emby-api-key"

# ==================== Cron 任务配置 ====================
# Cron API 验证密钥（可选，用于保护 /api/cron 端点）
# 如果设置，调用 /api/cron 时需要在 Authorization header 中提供 Bearer token
CRON_SECRET="your-cron-secret-key"

# Cron 定时任务执行时间（可选，使用标准 cron 表达式）
# 格式：分 时 日 月 周（5 个字段）
# 默认值：0 2 * * *（每天凌晨 2:00）
# 示例：
#   0 2 * * *    - 每天凌晨 2:00
#   0 */6 * * *  - 每 6 小时执行一次
#   0 12 * * *   - 每天中午 12:00
#   */30 * * * * - 每 30 分钟执行一次（仅用于测试）
CRON_SCHEDULE="0 2 * * *"

# Cron 时区配置（可选）
# 默认值：Asia/Shanghai（中国标准时间 UTC+8）
# 其他示例：
#   America/New_York - 美国东部时间
#   Europe/London    - 英国时间
#   UTC              - 协调世界时
CRON_TIMEZONE="Asia/Shanghai"

# ==================== Next.js 配置 ====================
# 应用访问地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==================== TheMovieDB 配置 ====================
# TMDB API 密钥（用于搜索影视信息）
# 获取方式：
# 1. 访问 https://www.themoviedb.org/ 并注册账号
# 2. 进入账户设置 -> API -> 申请 API Key
# 3. 选择"Developer"类型，填写应用信息即可获得
TMDB_API_KEY="your-tmdb-api-key"

# ==================== MoviePilot 配置 ====================
# MoviePilot 服务器地址（不要以 / 结尾）
# 用于自动订阅影视资源（Phase 2 功能）
MOVIEPILOT_URL="http://your-moviepilot-server:3001"

# MoviePilot 用户名
MOVIEPILOT_USERNAME="admin"

# MoviePilot 密码
MOVIEPILOT_PASSWORD="your-moviepilot-password"

# ==================== Telegram 通知配置 ====================
# Telegram Bot Token（可选，用于发送订阅通知）
# 获取方式：
# 1. 在 Telegram 中搜索 @BotFather
# 2. 发送 /newbot 创建机器人
# 3. 按提示设置机器人名称和用户名
# 4. 获得 Bot Token（格式：123456789:ABCdefGHIjklMNOpqrsTUVwxyz）
TELEGRAM_BOT_TOKEN="your-bot-token"

# Telegram 管理员 Chat ID（可选，接收通知的管理员）
# 获取方式：
# 1. 在 Telegram 中搜索 @userinfobot
# 2. 发送任意消息给它
# 3. 获得你的 Chat ID（格式：123456789）
TELEGRAM_ADMIN_CHAT_ID="your-chat-id"

# Telegram Webhook 校验密钥（Bot 必填）
# Telegram 会在 webhook 请求头中附带该值，用于验证请求来源
# 生成方法：openssl rand -hex 32
TELEGRAM_WEBHOOK_SECRET="your-telegram-webhook-secret"

# ==================== 内部服务通信 ====================
# 内部 API 密钥（Bot ↔ API 双向认证密钥）
# 生成方法：openssl rand -hex 32
INTERNAL_API_SECRET="your-internal-api-secret"

# Bot 通知地址（可选，不配置则不发通知）
# Docker 环境下通常为 http://bot:8000
BOT_NOTIFY_URL="http://localhost:8000"

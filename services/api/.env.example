# Go API 服务环境变量配置

# 服务器配置
PORT=8080
ENV=development

# 数据库连接（使用与 Next.js 相同的数据库）
DATABASE_URL="postgresql://postgres:password@localhost:5432/ember?schema=public"

# JWT 密钥（与 Next.js 保持一致）
JWT_SECRET="your-secret-key-min-32-chars-change-this-in-production"

# Emby 服务器配置
EMBY_URL="https://your-emby-server.com"
EMBY_API_KEY="your-emby-api-key"

# MoviePilot 配置
MOVIEPILOT_URL="http://your-moviepilot-server:3001"
MOVIEPILOT_USERNAME="admin"
MOVIEPILOT_PASSWORD="your-moviepilot-password"

# Telegram Bot 配置（可选）
TELEGRAM_BOT_TOKEN="your-bot-token"
TELEGRAM_ADMIN_CHAT_ID="your-chat-id"

# 日志配置
LOG_LEVEL=info
LOG_FILE=logs/api.log

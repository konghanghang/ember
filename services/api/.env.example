# ==================== API 服务配置（仅保留必须通过环境变量注入的项） ====================
# 这里不再展示可改由数据库设置中心维护的配置。
# 只保留两类：
# 1) API 启动硬依赖
# 2) 只能放在环境变量里的可选密钥

# PostgreSQL 连接串（必填）
DATABASE_URL="postgresql://postgres:password@localhost:5432/ember?search_path=public"

# JWT 密钥（必填，至少 32 字符）
JWT_SECRET="your-secret-key-min-32-chars-change-this-in-production"

# 设置中心敏感配置加密主密钥（必填；新部署推荐随机 32 字节以上，已有环境必须保持原值）
CONFIG_ENCRYPTION_KEY="your-config-encryption-key-min-32-chars"

# 115 播放租约与转存配额 Redis；留空时 115 加速失败关闭，普通 Emby 播放不受影响。
# REDIS_URL="redis://127.0.0.1:6379/0"

# 内部服务通信（Bot <-> API）
INTERNAL_API_SECRET="your-internal-api-secret"

# 仅 ember gateway 使用：容器/进程可见的本地媒体只读根目录，留空关闭。
# PLAYBACK_LOCAL_MEDIA_ROOT="/media"

# 仅启用 Stripe webhook 时需要：只能通过环境变量注入
# STRIPE_WEBHOOK_SECRET="whsec_your_stripe_webhook_secret"

# 仅启用 Turnstile 登录校验时需要：只能通过环境变量注入
# TURNSTILE_SECRET_KEY="your-turnstile-secret-key"

# 仅启用 Emby webhook 回写追剧日历时需要：只能通过环境变量注入
# EMBY_WEBHOOK_TOKEN="your-emby-webhook-token"

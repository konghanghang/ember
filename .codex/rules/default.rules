# Ember project execpolicy rules.
# Source of intent:
# - `.claude/settings.json`
# - `.claude/settings.local.json`
# - repository constraints in `AGENTS.md`
#
# Notes:
# - Codex rules only govern commands that would run outside the sandbox.
# - File-read denies such as `Read(./.env)` are not expressible here.
# - Keep allow rules narrow; default to prompt or forbidden for risky commands.

# Safe inspection and validation commands that are routine for this repo.
prefix_rule(
    pattern = ["git", "status"],
    decision = "allow",
    justification = "Allow routine git workspace inspection.",
    match = [
        "git status",
        "git status --short",
    ],
)

prefix_rule(
    pattern = ["git", "diff"],
    decision = "allow",
    justification = "Allow routine git diff inspection.",
    match = [
        "git diff",
        "git diff --stat",
        "git diff --cached",
    ],
)

prefix_rule(
    pattern = ["git", "log"],
    decision = "allow",
    justification = "Allow routine git history inspection.",
    match = [
        "git log",
        "git log --oneline",
    ],
)

prefix_rule(
    pattern = ["git", "show"],
    decision = "allow",
    justification = "Allow routine git object inspection.",
    match = [
        "git show HEAD",
        "git show --stat HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "ls-tree"],
    decision = "allow",
    justification = "Allow routine git tree inspection.",
    match = [
        "git ls-tree HEAD",
    ],
)

prefix_rule(
    pattern = ["go", "build", "./..."],
    decision = "allow",
    justification = "Allow standard Go build validation for the whole backend.",
    match = [
        "go build ./...",
    ],
    not_match = [
        "go build ./cmd/server",
        "go build",
    ],
)

prefix_rule(
    pattern = ["go", "vet"],
    decision = "allow",
    justification = "Allow standard Go vet validation for the backend.",
)

prefix_rule(
    pattern = ["go", "test"],
    decision = "allow",
    justification = "Allow standard Go test validation for backend packages.",
)

prefix_rule(
    pattern = ["go", "-C", "services/api", ["test", "vet", "build"]],
    decision = "allow",
    justification = "Allow backend validation from the repository root without shell directory wrappers.",
    match = [
        "go -C services/api test ./...",
        "go -C services/api vet ./...",
        "go -C services/api build ./...",
    ],
    not_match = [
        "go -C services/api run ./cmd/server",
        "go -C services/web test ./...",
    ],
)

prefix_rule(
    pattern = ["go", "-C=services/api", ["test", "vet", "build"]],
    decision = "allow",
    justification = "Allow the equivalent compact Go working-directory form for backend validation.",
    match = [
        "go -C=services/api test ./...",
        "go -C=services/api vet ./...",
        "go -C=services/api build ./...",
    ],
    not_match = [
        "go -C=services/api run ./cmd/server",
        "go -C=services/web test ./...",
    ],
)

prefix_rule(
    pattern = ["gofmt", "-w"],
    decision = "allow",
    justification = "Allow formatting explicitly selected Go source files.",
    match = [
        "gofmt -w internal/config/config.go",
        "gofmt -w internal/config/config.go internal/config/config_test.go",
    ],
    not_match = [
        "gofmt -d internal/config/config.go",
        "gofmt internal/config/config.go",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "build"],
    decision = "allow",
    justification = "Allow standard frontend production build validation.",
    match = [
        "npm run build",
    ],
    not_match = [
        "npm run dev",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "test"],
    decision = "allow",
    justification = "Allow standard Vitest test runs for the frontend.",
    match = [
        "npm run test",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "test:unit"],
    decision = "allow",
    justification = "Allow focused frontend unit-test runs.",
    match = [
        "npm run test:unit",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "test:component"],
    decision = "allow",
    justification = "Allow focused frontend component-test runs.",
    match = [
        "npm run test:component",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "test:coverage"],
    decision = "allow",
    justification = "Allow frontend coverage test runs during validation.",
    match = [
        "npm run test:coverage",
    ],
)

prefix_rule(
    pattern = ["npm", "test"],
    decision = "allow",
    justification = "Allow npm test built-in alias for frontend test runs.",
    match = [
        "npm test",
    ],
)

prefix_rule(
    pattern = ["npx", "vitest"],
    decision = "allow",
    justification = "Allow direct Vitest invocation for focused frontend test runs.",
)

prefix_rule(
    pattern = ["python", "-m", "py_compile"],
    decision = "allow",
    justification = "Allow Bot syntax compilation validation for any module file.",
)

prefix_rule(
    pattern = ["python", "-m", "compileall"],
    decision = "allow",
    justification = "Allow Bot batch syntax compilation validation.",
)

prefix_rule(
    pattern = ["python", "-m", "unittest"],
    decision = "allow",
    justification = "Allow Bot unittest runs.",
)

prefix_rule(
    pattern = ["python", "-m", "pytest"],
    decision = "allow",
    justification = "Allow Bot pytest runs invoked through python -m.",
)

prefix_rule(
    pattern = ["pytest"],
    decision = "allow",
    justification = "Allow Bot pytest runs (direct invocation).",
)

prefix_rule(
    pattern = ["python3", "-m", "py_compile"],
    decision = "allow",
    justification = "Allow Bot syntax compilation validation when Python 3 is invoked explicitly.",
)

prefix_rule(
    pattern = ["python3", "-m", "compileall"],
    decision = "allow",
    justification = "Allow Bot batch syntax compilation validation when Python 3 is invoked explicitly.",
)

prefix_rule(
    pattern = ["python3", "-m", "unittest"],
    decision = "allow",
    justification = "Allow Bot unittest runs when Python 3 is invoked explicitly.",
)

prefix_rule(
    pattern = ["python3", "-m", "pytest"],
    decision = "allow",
    justification = "Allow Bot pytest runs invoked through python3 -m.",
)

# Commands that mutate local state but do not create user-visible history can
# be selectively allowed to reduce approval noise.
prefix_rule(
    pattern = ["git", "add"],
    decision = "allow",
    justification = "Allow staging tracked changes to reduce duplicate approval prompts before commit.",
    match = [
        "git add AGENTS.md",
        "git add .",
    ],
)

# `AGENTS.md` already governs whether a commit is allowed at all: the agent
# must ask first and only commit after explicit user approval. Once that
# approval exists, `git commit` itself should not trigger a second policy
# conversation for the same action.
prefix_rule(
    pattern = ["git", "commit"],
    decision = "allow",
    justification = "Allow commit execution without duplicate policy prompts after the user has explicitly requested a commit per AGENTS.md.",
)

prefix_rule(
    pattern = ["git", "push"],
    decision = "prompt",
    justification = "Pushing changes affects remote history and should stay explicit.",
    match = [
        "git push",
        "git push origin master",
    ],
)

prefix_rule(
    pattern = ["git", "pull"],
    decision = "prompt",
    justification = "Pulling can rewrite the local working state and should stay explicit.",
    match = [
        "git pull",
        "git pull --rebase",
    ],
)

prefix_rule(
    pattern = ["git", "checkout"],
    decision = "prompt",
    justification = "Checkout may switch branches or overwrite files; review each use.",
    match = [
        "git checkout master",
        "git checkout -- AGENTS.md",
    ],
)

prefix_rule(
    pattern = ["git", "reset"],
    decision = "prompt",
    justification = "Reset can discard or rewrite state; require confirmation.",
    match = [
        "git reset HEAD~1",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "rm"],
    decision = "prompt",
    justification = "Removing tracked files should stay explicit.",
    match = [
        "git rm README.md",
    ],
)

prefix_rule(
    pattern = ["rm"],
    decision = "prompt",
    justification = "File deletion outside the sandbox should always be reviewed.",
    match = [
        "rm tmp.txt",
        "rm -rf tmpdir",
    ],
)

prefix_rule(
    pattern = ["mkdir"],
    decision = "prompt",
    justification = "Directory creation outside the sandbox should stay explicit.",
    match = [
        "mkdir tmp",
        "mkdir -p .codex/rules",
    ],
)

prefix_rule(
    pattern = ["cp"],
    decision = "prompt",
    justification = "Copying files outside the sandbox should stay explicit.",
    match = [
        "cp a b",
    ],
)

prefix_rule(
    pattern = ["mv"],
    decision = "prompt",
    justification = "Moving files outside the sandbox should stay explicit.",
    match = [
        "mv a b",
    ],
)

prefix_rule(
    pattern = ["npm", "install"],
    decision = "prompt",
    justification = "Installing packages changes dependencies and may hit the network.",
    match = [
        "npm install",
        "npm install axios",
    ],
)

prefix_rule(
    pattern = ["psql"],
    decision = "prompt",
    justification = "Database access can inspect or mutate live data; require confirmation.",
    match = [
        "psql postgres://localhost/db",
    ],
)

prefix_rule(
    pattern = ["curl"],
    decision = "prompt",
    justification = "Network requests should stay explicit when run outside the sandbox.",
    match = [
        "curl -I https://example.com",
    ],
)

# Hard blocks for commands that conflict with repository rules or are
# unnecessarily dangerous for routine Codex use.
prefix_rule(
    pattern = ["rm", "-rf"],
    decision = "prompt",
    justification = "Recursive force delete is dangerous and must require explicit approval each time.",
    match = [
        "rm -rf tmpdir",
        "rm -rf /tmp/something",
    ],
)

prefix_rule(
    pattern = ["git", "reset", "--hard"],
    decision = "forbidden",
    justification = "Do not discard worktree state with `git reset --hard`.",
    match = [
        "git reset --hard HEAD",
        "git reset --hard HEAD~1",
    ],
)

prefix_rule(
    pattern = ["git", "checkout", "--"],
    decision = "forbidden",
    justification = "Do not overwrite tracked files with `git checkout --`.",
    match = [
        "git checkout -- AGENTS.md",
    ],
)

prefix_rule(
    pattern = ["go", "run"],
    decision = "forbidden",
    justification = "Repository rules forbid starting services from the coding agent.",
    match = [
        "go run ./cmd/server",
    ],
)

prefix_rule(
    pattern = ["go", "-C", "services/api", "run"],
    decision = "forbidden",
    justification = "Do not bypass the repository's `go run` restriction with Go's working-directory flag; use tests or builds instead.",
    match = [
        "go -C services/api run ./cmd/server",
        "go -C services/api run ./cmd/p115-contract-check",
    ],
)

prefix_rule(
    pattern = ["go", "-C=services/api", "run"],
    decision = "forbidden",
    justification = "Do not bypass the repository's `go run` restriction with Go's compact working-directory flag; use tests or builds instead.",
    match = [
        "go -C=services/api run ./cmd/server",
        "go -C=services/api run ./cmd/p115-contract-check",
    ],
)

prefix_rule(
    pattern = ["npm", "run", "dev"],
    decision = "forbidden",
    justification = "Repository rules forbid starting frontend dev servers from the coding agent.",
    match = [
        "npm run dev",
    ],
)

# Ember Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值
#
# Compose 启动行为：
#   - 以 `:?` 结尾的变量为强制变量，缺失时 `docker compose up` 会直接拒绝启动
#   - 其余变量缺失时 compose 会以空字符串注入并打印 warning，由业务自行决定是否启用对应能力
#
# 密钥生成（Linux / macOS / WSL / Git Bash）：
#   openssl rand -hex 32   # 32 字节强密钥（JWT、加密主密钥、内部 API、webhook secret）
#   openssl rand -hex 16   # PostgreSQL 密码等中等强度场景
# Windows 原生 PowerShell 不带 openssl，请使用 WSL 或 Git Bash。

# ==================== PostgreSQL（必须）====================
POSTGRES_USER=ember
# PostgreSQL 密码（生成：openssl rand -hex 16）
POSTGRES_PASSWORD=
POSTGRES_DB=ember

# DATABASE_URL 默认由 compose 内部按 POSTGRES_USER/PASSWORD/DB 自动拼接到内置 postgres，无需显式提供。
# 如需指向独立 DB（compose 外部 PostgreSQL），取消下行注释并填入完整 DSN：
# DATABASE_URL=postgres://user:pass@host:5432/dbname?sslmode=require

# ==================== Ember 应用日志 ====================
# API、Gateway、Bot 共用；默认 info，排查时临时改为 debug 并重启目标服务。
# 只控制 Ember 应用日志，不控制 PostgreSQL、Nginx、Docker driver 或浏览器 console。
LOG_LEVEL=info

# ==================== 安全密钥（必须）====================
# JWT 签名密钥（生成：openssl rand -hex 32）
JWT_SECRET=

# 设置中心敏感配置加密主密钥（生成：openssl rand -hex 32）
CONFIG_ENCRYPTION_KEY=

# 内部服务通信密钥（API ↔ Bot 共享，生成：openssl rand -hex 32）
INTERNAL_API_SECRET=

# ==================== Playback Gateway ====================
# Gateway 进程固定监听容器内 8081；这里只控制宿主机回环映射端口。
# 公网访问必须由宿主机 Nginx/Caddy/Cloudflare Tunnel 提供 HTTPS 反向代理。
# 使用包含统一入口的新镜像后，通过 docker compose --profile gateway up -d 启用。
PLAYBACK_GATEWAY_PORT=8081

# ==================== 默认管理员（首启用）====================
# 仅在 users 表为空时使用
ADMIN_USERNAME=admin
# ADMIN_PASSWORD 留空时 API 首启会生成临时管理员口令并要求首次登录改密；
# 显式提供时部署后请立即在控制台改密
ADMIN_PASSWORD=

# ==================== Telegram Bot ====================
# Bot 必须：
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 默认 webhook，可选 polling（polling 模式仅允许单实例部署）
TELEGRAM_UPDATE_MODE=webhook

# 仅 webhook 模式需要（生成：openssl rand -hex 32）：
TELEGRAM_WEBHOOK_SECRET=
# 只填 Bot 对外基地址；实际 Telegram 回调地址 = ${WEBHOOK_URL}/telegram/webhook
WEBHOOK_URL=https://your-domain.com

# 以下两项已托管到设置中心，env 仅作启动期兜底，可留空
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# ==================== Emby Webhook ====================
# 用于校验 Emby 入库 webhook 来源
EMBY_WEBHOOK_TOKEN=your-emby-webhook-token

# ==================== Cron 配置 ====================
# 注意：以下项已托管到设置中心数据库，env 仅作启动期兜底；改完需要重启 API 才会生效

# 是否启用 API 内置 cron（默认 true）
CRON_ENABLED=true

# 是否启用播放排行榜 cron（默认 false，避免未配置 Emby/未安装插件时刷错误日志）
RANKING_CRON_ENABLED=false

# 可选：自定义排行 cron 表达式
# - 日榜：每天 20:00
# - 周榜：周日 20:30
# RANKING_DAILY_SCHEDULE="0 20 * * *"
# RANKING_WEEKLY_SCHEDULE="30 20 * * 0"

# 可选：追剧日历同步 cron 表达式（默认每 12 小时一次）
# TV_CALENDAR_SYNC_SCHEDULE="0 */12 * * *"

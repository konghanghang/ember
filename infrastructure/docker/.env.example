# Ember Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值
#
# Compose 启动行为：
#   - 以 `:?` 结尾的变量为强制变量，缺失时 `docker compose up` 会直接拒绝启动
#   - 其余变量缺失时 compose 会以空字符串注入并打印 warning，由业务自行决定是否启用对应能力

# ==================== PostgreSQL（必须）====================
POSTGRES_USER=ember
POSTGRES_PASSWORD=change-me-strong-password
POSTGRES_DB=ember

# 应用读取的 DSN，与上面的 user/password/db 保持一致
DATABASE_URL=postgres://ember:change-me-strong-password@postgres:5432/ember?sslmode=disable

# ==================== 安全密钥（必须）====================
# JWT 密钥（至少 32 字符）
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# 设置中心敏感配置加密主密钥（至少 32 字符）
CONFIG_ENCRYPTION_KEY=your-config-encryption-key-change-in-production-min-32-chars

# 内部服务通信密钥（API ↔ Bot 共享）
INTERNAL_API_SECRET=your-internal-api-secret-change-in-production

# ==================== 默认管理员（首启用）====================
# 仅在 users 表为空时使用，部署后请立即在控制台修改密码
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me-on-first-login

# ==================== Telegram Bot ====================
# Bot 必须：
TELEGRAM_BOT_TOKEN=your-telegram-bot-token

# 默认 webhook，可选 polling（polling 模式仅允许单实例部署）
TELEGRAM_UPDATE_MODE=webhook

# 仅 webhook 模式需要：
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret
WEBHOOK_URL=https://your-domain.com/webhook

# 以下两项已托管到设置中心，env 仅作启动期兜底，可留空
TELEGRAM_ADMIN_CHAT_ID=
TELEGRAM_GROUP_CHAT_ID=

# ==================== Emby Webhook ====================
# 用于校验 Emby 入库 webhook 来源
EMBY_WEBHOOK_TOKEN=your-emby-webhook-token

# ==================== Cron 配置 ====================
# 注意：以下项已托管到设置中心数据库，env 仅作启动期兜底；改完需要重启 API 才会生效

# 是否启用 API 内置 cron（默认 true）
CRON_ENABLED=true

# 是否启用播放排行榜 cron（默认 false，避免未配置 Emby/未安装插件时刷错误日志）
RANKING_CRON_ENABLED=false

# 可选：自定义排行 cron 表达式
# - 日榜：每天 20:00
# - 周榜：周日 20:30
# RANKING_DAILY_SCHEDULE="0 20 * * *"
# RANKING_WEEKLY_SCHEDULE="30 20 * * 0"

# 可选：追剧日历同步 cron 表达式（默认每 12 小时一次）
# TV_CALENDAR_SYNC_SCHEDULE="0 */12 * * *"

# Ember Docker Compose 环境变量配置
# 复制此文件为 .env 并填入实际值

# JWT 密钥（至少 32 字符）
JWT_SECRET=your-secret-key-change-in-production-min-32-chars

# Emby 服务器配置
EMBY_URL=http://your-emby-server:8096
EMBY_API_KEY=your-emby-api-key

# 内部服务通信密钥
INTERNAL_API_SECRET=your-internal-api-secret-change-in-production

# Telegram Bot 配置
TELEGRAM_BOT_TOKEN=your-telegram-bot-token
TELEGRAM_ADMIN_CHAT_ID=your-admin-chat-id
# 可选：群组 Chat ID（用于播放排行榜等群推送；未配置时回退到管理员）
TELEGRAM_GROUP_CHAT_ID=
TELEGRAM_WEBHOOK_SECRET=your-webhook-secret

# Webhook URL（用于 Telegram Bot）
WEBHOOK_URL=https://your-domain.com/webhook

# ==================== Cron 配置 ====================
# 是否启用 API 内置 cron（默认 true）
CRON_ENABLED=true

# 是否启用播放排行榜 cron（默认 false，避免未配置 Emby/未安装插件时刷错误日志）
RANKING_CRON_ENABLED=false

# 可选：自定义排行 cron 表达式
# 阶段榜推荐（阅读高峰）：
# - 日榜：每天 20:00
# - 周榜：周日 20:30
# RANKING_DAILY_SCHEDULE="0 20 * * *"
# RANKING_WEEKLY_SCHEDULE="30 20 * * 0"

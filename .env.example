# ==================== 数据库配置 ====================
# PostgreSQL 数据库连接字符串
DATABASE_URL="postgresql://postgres:password@localhost:5432/ember?schema=public"

# ==================== JWT 认证配置 ====================
# JWT 密钥（至少 32 个字符，生产环境必须修改）
JWT_SECRET="your-secret-key-min-32-chars-change-this-in-production"

# ==================== Emby 服务器配置 ====================
# Emby 服务器地址（不要以 / 结尾）
EMBY_URL="https://your-emby-server.com"

# Emby API 密钥（在 Emby 后台生成）
EMBY_API_KEY="your-emby-api-key"

# ==================== Cron 任务配置 ====================
# Cron API 验证密钥（可选，用于保护 /api/cron 端点）
# 如果设置，调用 /api/cron 时需要在 Authorization header 中提供 Bearer token
CRON_SECRET="your-cron-secret-key"

# ==================== Next.js 配置 ====================
# 应用访问地址
NEXT_PUBLIC_APP_URL="http://localhost:3000"
